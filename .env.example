# Copy to apps/mcp-worker/.dev.vars for local Worker development. Never commit real values.

# Groq AI (optional; deterministic search works without it)
GROQ_API_KEY=replace_me
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=replace_with_a_supported_model_id
GROQ_ENABLED=false
GROQ_TIMEOUT_MS=30000
GROQ_MAX_COMPLETION_TOKENS=1200
GROQ_TEMPERATURE=0.2
GROQ_MAX_INPUT_CHARS=24000

# Worker / application
APP_ENV=development
APP_BASE_URL=http://localhost:8787
LOG_LEVEL=info

# MCP client authentication: comma-separated bearer tokens. REQUIRED when APP_ENV=production.
MCP_AUTH_TOKENS=local-mcp-token

# Ingestion service (Python parser). Separate secrets: admin vs parser callbacks.
INGESTION_SERVICE_URL=http://localhost:8000
INGESTION_SERVICE_TOKEN=replace_me
PARSER_CALLBACK_TOKEN=replace_me
ADMIN_API_TOKEN=replace_me

# Source crawler
GHC_SOURCE_URL=https://ghconline.gov.in/index.php/consolidated-cause-list/
CRAWLER_USER_AGENT=GHC-Cause-List-MCP/1.0 (contact: configure-a-contact-address)
CRAWLER_MIN_INTERVAL_MS=3000
CRAWLER_MAX_DOWNLOAD_BYTES=52428800
CRAWL_LOOKBACK_DAYS=14
RECHECK_DAYS=3
MAX_DOWNLOADS_PER_CRAWL=60
